{
  "name": "farmsapp-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":             "next dev",
    "dev:local":       "dotenv -e .env.local -- next dev",
    "dev:dev":         "dotenv -e .env.dev -- next dev",
    "dev:uat":         "dotenv -e .env.uat -- next dev",
    "dev:local-prod":  "dotenv -e .env.local-prod -- next dev",
    "build":           "next build",
    "build:dev":       "dotenv -e .env.dev -- next build",
    "build:uat":       "dotenv -e .env.uat -- next build",
    "build:prod":      "dotenv -e .env.prod -- next build",
    "start":           "next start",
    "start:dev":       "dotenv -e .env.dev -- next start",
    "start:uat":       "dotenv -e .env.uat -- next start",
    "start:prod":      "dotenv -e .env.prod -- next start",
    "lint":            "next lint",
    "type-check":      "tsc --noEmit",
    "analyze":         "ANALYZE=true next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.17.0",
    "next": "14.2.35",
    "next-intl": "^4.13.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.77.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
