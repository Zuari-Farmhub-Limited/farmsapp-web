# ============================================================
# Copy this file to .env.local / .env.dev / .env.uat / .env.prod
# and fill in the values for each profile
# ============================================================
NEXT_PUBLIC_PROFILE=local|dev|uat|prod|local-prod

# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8084
API_BASE_URL=http://localhost:8084

# Basic Auth — used ONLY for trigger-otp and login (base64 encoded)
API_BASIC_AUTH=

# API Auth Key — secondary key used for certain API calls
API_AUTH_KEY=

# Auth session secret (min 32 chars)
AUTH_SECRET=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# App
NEXT_PUBLIC_APP_NAME=FarmsApp
NEXT_PUBLIC_SUPPORT_EMAIL=support@farmsapp.in
